{% extends 'base.html.twig' %}

{% block title %}Global Tour | Home{% endblock %}

{% block body %}

    <div class="" style="background-color: #ff0000">
        <h1 class="text-center fw-bold text-white">Welcome to {{ company_name }}</h1>
        <p class="text-center fw-bold text-white">Your gateway to unforgettable travel experiences around the world.</p>
    </div>
    {# the hero #}
    <main class="main">

    <!-- Hero Section -->
    <section id="hero" class="hero section">

      <img src="{{ asset('img/hero-bg.jpg') }}" alt="" data-aos="fade-in">

      <div class="container">
        <h2 data-aos="fade-up" data-aos-delay="100" class="">Explore the World,<br>Create Lasting Memories</h2>
        <p data-aos="fade-up" data-aos-delay="200">Discover breathtaking destinations, curated journeys, and unforgettable travel experiences with our expert guides.</p>
        <div class="d-flex mt-4" data-aos="fade-up" data-aos-delay="300">
          <a href="" class="btn-get-started">Start Your Journey</a>
        </div>
      </div>

    </section><!-- /Hero Section -->

    <!-- About Section -->
    <section id="about" class="about section">

      <div class="container">

        <div class="row gy-4">

          <div class="col-lg-6 order-1 order-lg-2" data-aos="fade-up" data-aos-delay="100">
            <img src="{{ asset('img/about.jpg') }}" class="img-fluid shadow-sm" alt="">
          </div>

          <div class="col-lg-6 order-2 order-lg-1 content" data-aos="fade-up" data-aos-delay="200">
            <h3>Discover the World with Us</h3>
            <p class="fst-italic">
              We specialize in creating unforgettable travel experiences that take you to the heart of the world's most beautiful destinations. Our expertly crafted tours combine adventure, culture, and relaxation.
            </p>
            <ul>
              <li><i class="bi bi-check-circle"></i> <span>Expert guides with years of international travel experience.</span></li>
              <li><i class="bi bi-check-circle"></i> <span>Customized itineraries tailored to your preferences and budget.</span></li>
              <li><i class="bi bi-check-circle"></i> <span>All-inclusive packages with accommodations, meals, and guided tours for worry-free travel adventures.</span></li>
            </ul>
            <a href="#" class="read-more"><span>Read More</span><i class="bi bi-arrow-right"></i></a>
          </div>

        </div>

      </div>

    </section><!-- /About Section -->

    <!-- Counts Section -->
    <section id="counts" class="section counts">

      <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row gy-4">

          <div class="col-lg-3 col-md-6">
            <div class="stats-item text-center w-100 h-100">
              <span data-purecounter-start="0" data-purecounter-end="1232" data-purecounter-duration="1" class="purecounter"></span>
              <p class="">Happy Travelers</p>
            </div>
          </div><!-- End Stats Item -->

          <div class="col-lg-3 col-md-6">
            <div class="stats-item text-center w-100 h-100">
              <span data-purecounter-start="0" data-purecounter-end="64" data-purecounter-duration="1" class="purecounter"></span>
              <p class="">Destinations</p>
            </div>
          </div><!-- End Stats Item -->

          <div class="col-lg-3 col-md-6">
            <div class="stats-item text-center w-100 h-100">
              <span data-purecounter-start="0" data-purecounter-end="42" data-purecounter-duration="1" class="purecounter"></span>
              <p class="">Guided Tours</p>
            </div>
          </div><!-- End Stats Item -->

          <div class="col-lg-3 col-md-6">
            <div class="stats-item text-center w-100 h-100">
              <span data-purecounter-start="0" data-purecounter-end="24" data-purecounter-duration="1" class="purecounter"></span>
              <p class="">Tour Guides</p>
            </div>
          </div><!-- End Stats Item -->

        </div>

      </div>

